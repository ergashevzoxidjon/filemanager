# config.php va data papkasini brauzerdan ochib bo'lmasin
<FilesMatch "^(config\.php|config\.example\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
