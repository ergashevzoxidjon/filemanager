# ===== OFIS FAYL-BOT SOZLAMALARI =====
# Qiymatlarni qo'shtirnoqsiz yozing.

# 1) Telegram bot tokeni (@BotFather beradi)
BOT_TOKEN=BU_YERGA_TOKEN_YOZING

# 2) Botdan foydalana oladigan odamlarning Telegram ID'lari (vergul bilan)
#    O'z ID'ingizni @userinfobot dan bilib olasiz
ALLOWED_USERS=123456789

# 3) «Guruhga yuborish» tugmasi uchun guruh ID'si (ixtiyoriy).
#    Istalgan chatga yuborish uchun bu shart emas - fayl ostidagi «Ulashish» tugmasi bor
#    Botni guruhga qo'shib, guruhda /id yozing. Odatda -100 bilan boshlanadi
GROUP_ID=

# 4) Bot ko'radigan joylar. * = kompyuterdagi barcha disklar va barcha fayllar (standart).
#    Faqat ayrim joylar kerak bo'lsa, nuqtali vergul bilan yozing: D:\;E:\Arxiv
ROOTS=*

# 5) Tez papkalar - ko'p kerak bo'ladiganlar (ixtiyoriy)
#    Masalan: D:\Zakazlar;D:\Maketlar
FAVORITES=

# 6) 49 MB dan katta fayl shu hajmdagi bo'laklarga bo'linadi (MB, 49 dan oshmasin)
PART_MB=45

# 7) Bundan katta fayllar umuman yuborilmaydi (MB)
MAX_FILE_MB=1000

# 8) Bot ishga tushganda sizga xabar yuborsinmi (1 - ha, 0 - yo'q)
NOTIFY_START=1

# ===== KO'P KOMPYUTER REJIMI (ixtiyoriy) =====
# Bitta bot bilan bir nechta kompyuterni boshqarish uchun hub (hostingdagi hub.php) kerak.
# Bitta kompyuter bo'lsa, bu qismni bo'sh qoldiring.

# Hub manzili, masalan: https://saytingiz.uz/filebot/hub.php
HUB_URL=

# Shu kompyuterning qisqa nomi (1-10 lotin harf/raqam). Hub config.php dagi nom bilan bir xil
AGENT_ID=ofis

# Shu kompyuterning maxfiy kaliti (hub config.php dagi key bilan bir xil). yangi_kalit.bat yaratib beradi
AGENT_KEY=

# Telefonda ko'rinadigan nom
AGENT_NAME=Ofis kompyuteri
